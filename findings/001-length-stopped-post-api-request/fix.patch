From a19c0328f7ebb420d722efd998dc7b359d2ee2bc Mon Sep 17 00:00:00 2001
From: 0xMiiracle <miracledoxxed@gmail.com>
Date: Fri, 6 Nov 2026 23:12:28 +0100
Subject: [PATCH] fix(agent): fire post_api_request for length-stopped attempts

A reply that stops on finish_reason=length goes to recover_from_truncation
in check_api_response before normalize_model_response runs, and that is the
only place post_api_request fires. The cut-off attempt is a finished provider
call, so a plugin that opened a span on pre_api_request never sees it end.

Fire the hook for that attempt before truncation recovery, best-effort like
every other observer call.
---
 agent/turn_response_check.py                  | 20 +++++
 .../test_length_stopped_post_api_request.py   | 80 +++++++++++++++++++
 2 files changed, 100 insertions(+)
 create mode 100644 tests/agent/test_length_stopped_post_api_request.py

diff --git a/agent/turn_response_check.py b/agent/turn_response_check.py
index 38380728..abab7634 100644
--- a/agent/turn_response_check.py
+++ b/agent/turn_response_check.py
@@ -89,6 +89,21 @@ def _derive_finish_reason(agent: Any, response: Any, messages: Any) -> str:
     return finish_reason
 
 
+def _fire_post_api_request_for_truncated(
+    agent: Any, response: Any, finish_reason: Any, *, api_messages: Any, api_call_count: Any,
+    api_duration: Any, api_start_time: Any, api_request_id: Any, effective_task_id: Any, turn_id: Any,
+) -> None:
+    """``post_api_request`` for a length-stopped attempt: it is a finished provider call, but
+    truncation recovery runs before ``normalize_model_response`` would fire the hook."""
+    from agent.turn_response_intake import _fire_post_api_request_hook, normalize_response_for_agent
+    _fire_post_api_request_hook(
+        agent, response, normalize_response_for_agent(agent, response), finish_reason,
+        api_messages=api_messages, api_call_count=api_call_count, api_duration=api_duration,
+        api_start_time=api_start_time, api_request_id=api_request_id,
+        effective_task_id=effective_task_id, turn_id=turn_id,
+    )
+
+
 def check_api_response(
     agent: Any, *, response: Any, _retry: Any, thinking_spinner: Any, messages: Any,
     api_messages: Any, api_kwargs: Any, active_system_prompt: Any, conversation_history: Any,
@@ -171,6 +186,11 @@ def check_api_response(
         return _verdict("break")
 
     if finish_reason == "length":
+        _fire_post_api_request_for_truncated(
+            agent, response, finish_reason, api_messages=api_messages, api_call_count=api_call_count,
+            api_duration=api_duration, api_start_time=api_start_time, api_request_id=api_request_id,
+            effective_task_id=effective_task_id, turn_id=turn_id,
+        )
         _tv = recover_from_truncation(
             agent, response, finish_reason, _retry, messages=messages,
             conversation_history=conversation_history, api_kwargs=api_kwargs,
diff --git a/tests/agent/test_length_stopped_post_api_request.py b/tests/agent/test_length_stopped_post_api_request.py
new file mode 100644
index 00000000..a10fcee9
--- /dev/null
+++ b/tests/agent/test_length_stopped_post_api_request.py
@@ -0,0 +1,80 @@
+"""A length-stopped attempt still closes with ``post_api_request``.
+
+``finish_reason='length'`` sends the response to truncation recovery before
+``normalize_model_response``, which is where ``post_api_request`` fires. The attempt is a
+finished provider call, so an observer that opened a span on ``pre_api_request`` must see
+it end (observer-hooks.md: every request ends with ``post_api_request`` or
+``api_request_error``).
+"""
+
+from __future__ import annotations
+
+from types import SimpleNamespace
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+from hermes_constants import FINISH_REASON_LENGTH
+
+
+@pytest.fixture()
+def loop_agent():
+    from run_agent import AIAgent
+    with (
+        patch("model_tools.get_tool_definitions", return_value=[]),
+        patch("model_tools.check_toolset_requirements", return_value={}),
+        patch("agent.process_bootstrap.OpenAI"),
+    ):
+        a = AIAgent(
+            api_key="test-key-1234567890",
+            base_url="https://openrouter.ai/api/v1",
+            quiet_mode=True,
+            skip_context_files=True,
+            skip_memory=True,
+        )
+        a.client = MagicMock()
+        a._cached_system_prompt = "You are helpful."
+        a._use_prompt_caching = False
+        a.compression_enabled = False
+        a.save_trajectories = False
+        a.context_compressor.context_length = 200_000
+        return a
+
+
+def _response(content: str, finish_reason: str):
+    from tests.agent.test_run_agent import _mock_assistant_msg
+    return SimpleNamespace(
+        id="resp",
+        model="test/model",
+        choices=[SimpleNamespace(index=0, message=_mock_assistant_msg(content=content), finish_reason=finish_reason)],
+        usage=SimpleNamespace(prompt_tokens=100, completion_tokens=40, total_tokens=140),
+    )
+
+
+def test_length_stopped_attempt_fires_post_api_request(loop_agent):
+    loop_agent.client.chat.completions.create.side_effect = [
+        _response("This answer is cut off mid", FINISH_REASON_LENGTH),
+        _response(" sentence and continues here.", "stop"),
+    ]
+    hook_calls = []
+
+    def _record_hook(name, **kwargs):
+        hook_calls.append((name, kwargs))
+        return []
+
+    with (
+        patch("hermes_cli.lifecycle.has_hook",
+              side_effect=lambda name: name in {"pre_api_request", "post_api_request", "api_request_error"}),
+        patch("hermes_cli.lifecycle.invoke_hook", side_effect=_record_hook),
+        patch.object(loop_agent, "_persist_session"),
+        patch.object(loop_agent, "_save_trajectory"),
+        patch.object(loop_agent, "_cleanup_task_resources"),
+    ):
+        loop_agent.run_conversation("write a long answer")
+
+    pre = [kw["api_request_id"] for name, kw in hook_calls if name == "pre_api_request"]
+    closed = [kw["api_request_id"] for name, kw in hook_calls if name in {"post_api_request", "api_request_error"}]
+    assert len(pre) == 2
+    assert closed == pre
+    first_post = next(kw for name, kw in hook_calls if name == "post_api_request")
+    assert first_post["finish_reason"] == FINISH_REASON_LENGTH
